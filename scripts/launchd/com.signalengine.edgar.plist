<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly EDGAR fundamentals refresh (submissions + companyfacts).

  Runs Sunday 09:00 local — no market activity, no contention with the
  nightly IJR/prices jobs. ~20 min at 8 req/s for the ~750-CIK universe.
  Idempotent: upserts by accession, ON CONFLICT DO NOTHING.

  Install (one-time):
    cp scripts/launchd/com.signalengine.edgar.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.signalengine.edgar.plist

  Status / logs:
    launchctl list | grep signalengine
    tail -f data_store/logs/edgar.{stdout,stderr}.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.signalengine.edgar.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signalengine.edgar</string>

  <key>WorkingDirectory</key>
  <string>/Users/amardani/EverythingEnergy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/amardani/EverythingEnergy/.venv/bin/python</string>
    <string>/Users/amardani/EverythingEnergy/scripts/ingest_edgar.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/amardani/EverythingEnergy/data_store/logs/edgar.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/amardani/EverythingEnergy/data_store/logs/edgar.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
