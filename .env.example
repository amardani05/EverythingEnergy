# Copy to .env (gitignored) and fill in. Keys are loaded from the shell env;
# nothing in this repo reads .env directly — `source .env` before running, or
# export them in your shell profile.

# SEC EDGAR — used only as the value for the User-Agent header
EDGAR_CONTACT_EMAIL=amard2@illinois.edu

# Optional macro / energy
FRED_API_KEY=
EIA_API_KEY=

# Databento futures loader (quotes are free; buying needs --buy)
DATABENTO_API_KEY=

# Massive Options Basic trial (free tier)
MASSIVE_API_KEY=
